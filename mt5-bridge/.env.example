# --- MT5 connection (this box must have MetaTrader 5 installed) ---
# If the terminal is ALREADY logged in, leave LOGIN/PASSWORD/SERVER blank — the
# bridge attaches to the running session. Only fill them to force a login.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=YourBroker-Demo

# Path to the exact terminal64.exe to attach to. REQUIRED if this box runs more
# than one MT5 terminal, so the bridge targets the right one (not just whichever
# MT5 answers first). Example (note forward slashes are fine):
# MT5_PATH=C:/Users/Administrator/Desktop/Ava Trade MT5 Terminal/terminal64.exe
MT5_PATH=

# --- API guard --- REQUIRED before exposing on the internet ---
# TLC must send this same value as `platforms.mt5.bridge_api_key` in its config.
# Leave blank ONLY for a fully private/localhost test.
BRIDGE_API_KEY=

# --- server ---
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
